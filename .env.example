# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
# Gmail: use a Google app password, never your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=abhinavpemmaraju@gmail.com
SMTP_PASSWORD=
# Optional when using another SMTP provider: its verified sender address.
# SMTP_FROM=portfolio@your-domain.com

# --- Private studio (/admin). See ADMIN_SETUP.md. ---
# Neon pooled connection string (postgresql://...). Leave empty to use bundled content only.
DATABASE_URL=
# Public origin of the site, e.g. http://localhost:3111 locally or https://<domain> in production.
NEXTAUTH_URL=
# Random 32-byte base64 value that signs sign-in sessions.
NEXTAUTH_SECRET=
# Google OAuth web client ID for owner sign-in.
GOOGLE_CLIENT_ID=
# Google OAuth web client secret.
GOOGLE_CLIENT_SECRET=
# Random 32-byte base64 key that encrypts the authenticator secret (AES-256-GCM).
ADMIN_ENCRYPTION_KEY=
# Development only: true runs an in-process Postgres (PGlite) in .local-db/. Ignored on Vercel and in production builds.
ADMIN_LOCAL_DB=
# Development only: true skips Google sign-in with a synthetic owner; the authenticator is still required. Never set on Vercel.
ADMIN_DEV_BYPASS=
